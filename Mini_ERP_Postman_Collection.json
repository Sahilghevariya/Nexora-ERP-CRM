						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Challan Confirmed Successfully\", function () {",
									"    if (pm.response.code === 200) {",
									"        pm.response.to.have.status(200);",
									"        console.log(\"Challan transaction committed and stock reduced.\");",
									"    } else {",
									"        pm.expect(pm.response.code).to.equal(400);",
									"        console.log(\"Deficit stock triggered rollback.\");",
									"    }",
									"});"
								],
